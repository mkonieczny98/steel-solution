DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zabudowy?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Wygeneruj własny: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"

# Adres strony (SEO, sitemap, linki w mailach)
NEXT_PUBLIC_SITE_URL="https://steelsolution.pl"

# Powiadomienia mailowe o nowych zapytaniach (opcjonalne – bez SMTP zapytania trafiają tylko do panelu)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
CONTACT_FROM="Steel Solution <no-reply@steelsolution.pl>"
CONTACT_TO="kontakt@steelsolution.pl"
