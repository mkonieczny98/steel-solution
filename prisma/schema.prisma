generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  image     String?
  role      String    @default("EDITOR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Category {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  description        String?
  longDescription    String?
  contentDescription String?   // Opis wyświetlany w sekcji między produktami a galerią
  image              String?
  heroImage          String?
  gallery            String    @default("[]")
  blocks             String?  // układ strony z kreatora (JSON z sekcjami); puste = układ domyślny
  icon               String?
  color              String    @default("blue")
  features        String    @default("[]")
  benefits        String    @default("[]")
  specifications  String    @default("[]")
  metaTitle       String?
  metaDescription String?
  sortOrder       Int       @default(0)
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  projects        Project[]
  vehicleBrands   CategoryVehicleBrand[]
}

model VehicleBrand {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  fullName           String?
  description        String?
  longDescription    String?
  contentDescription String?  // Opis wyświetlany w sekcji między produktami a galerią
  image              String?
  heroImage          String?
  gallery            String   @default("[]")
  blocks             String?  // układ strony z kreatora (JSON z sekcjami); puste = układ domyślny
  logo            String?
  type            String   @default("truck")
  models          String   @default("[]")
  metaTitle       String?
  metaDescription String?
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  categories      CategoryVehicleBrand[]
}

// Tabela łącząca - relacja many-to-many między kategoriami a markami pojazdów
model CategoryVehicleBrand {
  id             String       @id @default(cuid())
  categoryId     String
  vehicleBrandId String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vehicleBrand   VehicleBrand @relation(fields: [vehicleBrandId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([categoryId, vehicleBrandId])
  @@index([categoryId])
  @@index([vehicleBrandId])
}

model Project {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?
  content         String?
  thumbnail       String?
  images          String    @default("[]")
  vehicleBrand    String?
  vehicleModel    String?
  year            String?
  metaTitle       String?
  metaDescription String?
  featured        Boolean   @default(false)
  published       Boolean   @default(false)
  categoryId      String?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category? @relation(fields: [categoryId], references: [id])
  author          User      @relation(fields: [authorId], references: [id])

  @@index([categoryId])
  @@index([authorId])
}

// Strony budowane z bloków w panelu (/admin/strony). content = JSON z listą bloków.
model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  content     String?
  draft       String?
  revisions   PageRevision[]
  published   Boolean  @default(false)
  showInMenu  Boolean  @default(false)
  sortOrder   Int      @default(0)
  system      Boolean  @default(false) // strona główna i „O nas” – nie można ich usunąć ani zmienić adresu
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  alt         String?
  createdAt   DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  organization String?
  vehicle      String?
  category     String?
  subject      String   @default("")
  message      String
  read      Boolean  @default(false)
  requestId String? @unique
  projectSlug String?
  status String @default("new")
  notes String @default("")
  followUpAt DateTime?
  notificationStatus String @default("pending")
  notificationAttempts Int @default(0)
  notificationUpdatedAt DateTime?
  attachments ContactAttachment[]
  createdAt DateTime @default(now())
}

model ContactAttachment {
  id String @id @default(cuid())
  messageId String
  message ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name String
  mimeType String
  size Int
  data Bytes
  @@index([messageId])
}

model RequestLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model ConversionCount {
  key String @id
  day String
  event String
  page String
  count Int @default(1)
  @@index([day])
}

model PageRevision {
  id String @id @default(cuid())
  pageId String
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot String
  createdAt DateTime @default(now())
  @@index([pageId, createdAt])
}

model PageRedirect {
  from String @id
  to String
}
